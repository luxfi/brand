{
  "name": "@luxfi/brand",
  "version": "1.1.2",
  "description": "Official brand assets and design system for Lux Finance",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./brand.json": "./brand.json",
    "./bridge.json": "./bridge.json",
    "./financial.json": "./financial.json",
    "./loader": {
      "import": "./dist/loader.mjs",
      "require": "./dist/loader.js",
      "types": "./dist/loader.d.ts"
    },
    "./assets/*": "./assets/*",
    "./styles/*": "./styles/*",
    "./tokens.css": "./tokens.css"
  },
  "files": [
    "dist",
    "fonts",
    "styles",
    "brand.json",
    "bridge.json",
    "financial.json",
    "examples",
    "WHITELABEL.md",
    "tokens.css"
  ],
  "scripts": {
    "build": "node scripts/tokens.mjs && node scripts/assets.mjs && tsup src/index.ts src/loader.ts --format cjs,esm --dts --clean --external react",
    "dev": "tsup src/index.ts src/loader.ts --format cjs,esm --dts --watch --external react",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "assets:check": "node scripts/assets.mjs",
    "tokens": "node scripts/tokens.mjs"
  },
  "peerDependencies": {
    "react": ">=19.2.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "luxfi",
    "lux",
    "brand",
    "design-system",
    "defi",
    "blockchain",
    "ui",
    "assets"
  ],
  "author": "Lux Finance",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luxfi/brand"
  },
  "homepage": "https://github.com/luxfi/brand",
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "@hanzo/design": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@luxfi/logo": "catalog:"
  },
  "packageManager": "pnpm@11.24.0"
}
